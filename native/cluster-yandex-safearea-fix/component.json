{
  "id": "cluster-yandex-safearea-fix",
  "kind": "tool",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "title": "Yandex Maps cluster safe-area fix",
  "description": "Fixes the CarPlay instrument-cluster safe area for Yandex Maps on top of waze-on-cluster: moves the guidance-banner rectangle to where Yandex Maps needs it and keeps it there after each boot. The safe area is one rectangle for every CarPlay app, so this offset is right for Yandex Maps and may misplace the banner on others. Reversible; removing it restores waze-on-cluster's safe area.",
  "requires": {
    "mgu-deploy": "0.7.0",
    "waze-on-cluster": "0.7.1"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "activate": [
    "node",
    "safearead.js",
    "activate"
  ],
  "deactivate": [
    "node",
    "safearead.js",
    "deactivate"
  ],
  "files": [
    { "path": "safearea_patch.js", "from": "patch/safearea_patch.js", "mode": "0644" },
    { "path": "safearea_locate.js", "from": "patch/safearea_locate.js", "mode": "0644" },
    { "path": "safearead.js", "from": "patch/safearead.js", "mode": "0644" },
    { "path": "remount_lock.js", "from": "patch/remount_lock.js", "mode": "0644" },
    { "path": "safearea.conf", "from": "safearea.conf", "mode": "0644" },
    { "path": "LICENSE", "from": "LICENSE", "mode": "0644" }
  ],
  "units": [
    { "name": "cluster-yandex-safearea-fix.service", "from": "systemd/cluster-yandex-safearea-fix.service" }
  ],
  "enable": [
    { "unit": "cluster-yandex-safearea-fix.service", "target": "multi-user.target" }
  ],
  "recmgr": [
    "cluster-yandex-safearea-fix"
  ],
  "restart": [
    "cluster-yandex-safearea-fix.service"
  ]
}
